# 忽略临时文件
*.tmp
*.temp
*.log
*.bak
*.broken

# 忽略编译缓存
__pycache__/
*.pyc

# 忽略游戏日志和运行文件
Logs/
CenterLog/
DBServer/Log/
LoginGate/
LoginSrv/
LogServer/
RunGate/
Mir200/Log/
Mir200/GameGuard/Log/

# 忽略可执行文件和库文件
*.exe
*.dll
*.pdb

# 忽略特定大型可执行文件
单机测试.exe

# 忽略大型游戏文件
*.map
*.db
*.chm

# 忽略临时目录
temp/
temp_card.txt

# 忽略游戏运行数据
Mir200/DB/
Mir200/Guild/
Mir200/Notice/
Mir200/UserData/
Mir200/UserRanks/

# 忽略备份文件
*.bak*
*.new
