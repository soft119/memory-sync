[@Startup]

[@Login]
#IF
#act
ChangeBagCount = 126

;================================================
; 大逃杀 - 玩家死亡处理
; [@PlayDie] 玩家死亡时触发
; 逻辑：检测是否在副本 -> 爆装备 -> 广播 -> 传出
;================================================
[@PlayDie]
#IF
; 在副本内被玩家杀死
CHECKMAPNAME BRTL
CHECKCURRTARGETRACE = 0
#ACT
HumanDropUseItem -1 S99
HumanDropUseItem -1 S98
HumanDropUseItem -1 S97
SENDMSG 0 【大逃杀】<$CURRRTARGETNAME> 击杀了 <$USERNAME>！ 255 253
<$CURRRTARGETNAME>.MOV A200 +1
MOV A200 0
MOV A201 0
MAPMOVE 3 330 330
SENDMSG 6 【大逃杀】你已阵亡，装备爆落战场！ 255 0
BREAK

#IF
; 在副本内被怪物杀死
CHECKMAPNAME BRTL
#ACT
HumanDropUseItem -1 S99
HumanDropUseItem -1 S98
SENDMSG 0 【大逃杀】<$USERNAME> 被怪物击败，退出战场！ 255 80
MOV A200 0
MOV A201 0
MAPMOVE 3 330 330
SENDMSG 6 【大逃杀】你已阵亡，装备爆落战场！ 255 0
BREAK

#IF
#ACT
BREAK

;================================================
; 死亡前触发 - 复活符（副本内使用一次复活）
; A202=1 表示本局拥有一次复活机会
;================================================
[@NextDie]
#IF
CHECKMAPNAME BRTL
EQUAL A202 1
#ACT
MOV A202 0
ChangeModeEx 23 1 1
SENDMSG 5 【复活符】在原地复活了！复活机会已用尽！
BREAK

#IF
#ACT
BREAK

;================================================
; 大逃杀 - 主定时器 (60号) 每30秒触发
; G300=副本状态(0未开/1进行中/2结算)
; G301=阶段(0~5), G302=计时累计(每次+1)
;================================================
[@OnTimer60]
#IF
NOT EQUAL G300 1
#ACT
BREAK

#IF
#ACT
MOV G302 +1

; ===== 第1阶段：G302=1(30秒) -> 正式开始广播+刷基础怪 =====
#IF
EQUAL G301 0
EQUAL G302 1
#ACT
MOV G301 1
SENDMSG 0 【大逃杀】第一阶段：原始积累！砍稻草人鸡鹿升级发育！ 255 253
MonGen 稻草人 20 0
MonGen 野鸡 30 0
MonGen 鹿 20 0
MonGen 半兽人 15 0
BREAK

; ===== 第2阶段：G302=20(10分钟) -> 骷髅僵尸 =====
#IF
EQUAL G301 1
EQUAL G302 20
#ACT
MOV G301 2
SENDMSG 0 【大逃杀】第二阶段：快速发育！骷髅精灵与僵尸出现！ 255 253
MonGen 骷髅精灵 20 0
MonGen 骷髅武士 20 0
MonGen 腐尸 15 0
MonGen 多钩猫 10 0
BREAK

; ===== 第3阶段：G302=40(20分钟) -> 精英怪 =====
#IF
EQUAL G301 2
EQUAL G302 40
#ACT
MOV G301 3
SENDMSG 0 【大逃杀】第三阶段：顶级争夺！祖玛教主与赤月恶魔出现！终极装备掉落！ 255 253
MonGen 祖玛卫士 15 0
MonGen 祖玛教主 5 0
MonGen 赤月恶魔 5 0
BREAK

; ===== 第4阶段：G302=50(25分钟) -> 毒圈预警 =====
#IF
EQUAL G301 3
EQUAL G302 50
#ACT
MOV G301 4
SENDMSG 0 【大逃杀】魔龙结界开始收缩！存活玩家向地图中心集结！5分钟后副本结束！ 255 0
SETONTIMER 61 10
BREAK

; ===== 第5阶段：G302=60(30分钟) -> 副本结束 =====
#IF
EQUAL G301 4
EQUAL G302 60
#ACT
MOV G301 5
MOV G300 2
SETOFFTIMER 60
SETOFFTIMER 61
SENDMSG 0 【大逃杀】本局游戏结束！正在统计结果... 255 253
GOTO @大逃杀结算
BREAK

; ===== 每10轮(5分钟)刷一次空投宝箱 =====
#IF
EQUAL D99 0
#ACT
BREAK

#IF
#ACT
BREAK

;================================================
; 毒圈定时器 (61号) 每10秒触发
; 广播结界警告给副本玩家（氛围+压迫感）
;================================================
[@OnTimer61]
#IF
NOT EQUAL G300 1
#ACT
SETOFFTIMER 61
BREAK

#IF
#ACT
SENDMSG 0 【魔龙结界】正在收缩，边缘玩家请向中心移动！ 255 0
BREAK

;================================================
; 大逃杀 - 结算处理
;================================================
[@大逃杀结算]
#IF
CheckMapHumanCount BRTL = 0
#ACT
SENDMSG 0 【大逃杀】本局无人存活！ 255 80
MOV G300 0
MOV G301 0
MOV G302 0
DelMirrorMap BRTL
BREAK

#IF
#ACT
SENDMSG 0 【大逃杀】副本仍有玩家存活，时间到后引擎自动传出！ 255 253
MOV G300 0
MOV G301 0
MOV G302 0
DelMirrorMap BRTL
BREAK
